// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Konfigurasi koneksi ke Supabase / PostgreSQL
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// ENUM DEFINITIONS
// ------------------------------------------------------

enum JerseySize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum AddonType {
  MERCHANDISE
  CARBO_LOADING
  SHUTTLE
  HOTEL
}

enum ApprovalStatus {
  NONE // Untuk tiket reguler yang tidak butuh approval
  PENDING // Menunggu review EO (Link kualifikasi dicek)
  APPROVED // Lolos kualifikasi
  REJECTED // Gagal kualifikasi
}

// ------------------------------------------------------
// MODELS (RBAC - ROLE BASED ACCESS CONTROL)
// ------------------------------------------------------

// Tabel Peran Pengguna (Dinamis)
model Role {
  id          String        @id @default(cuid())
  name        String        @unique // Contoh: 'SUPER_ADMIN', 'EO', 'USER'
  description String?

  users       User[]
  permissions Permission[]
}

// Tabel Izin Akses (Dinamis)
model Permission {
  id          String  @id @default(cuid())
  name        String  @unique // Contoh: 'view_dashboard', 'manage_eo', 'manage_finance'
  description String?

  roles Role[]
}

// ------------------------------------------------------
// MODELS UTAMA
// ------------------------------------------------------

// 1. Tabel Pengguna (Multi-Tenant)
model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  phone    String?

  // Relasi ke tabel Role dinamis
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Soft Delete & Status Management
  isDeleted Boolean @default(false)
  status    String  @default("ACTIVE") // "ACTIVE" | "SUSPENDED"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       Event[]       @relation("EOEvents")
  transactions Transaction[]
  tickets      Ticket[]
}

// 2. TABEL BARU: Token Reset Password (Fitur Lupa/Reset Password Mandiri)
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

// 3. Tabel Event Lari
model Event {
  id           String    @id @default(cuid())
  title        String
  category     String?
  description  String
  date         DateTime
  endDate      DateTime?
  location     String
  mapsUrl      String?
  imageUrl     String?
  logoUrl      String?
  rules        String?
  contactName  String?
  contactPhone String?
  customFields Json?
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  eoId String
  eo   User   @relation("EOEvents", fields: [eoId], references: [id])

  categories TicketCategory[]
  promoCodes PromoCode[]
  addons     Addon[]
}

// 4. Tabel Kategori Tiket
model TicketCategory {
  id              String  @id @default(cuid())
  name            String
  price           Float
  capacity        Int
  elevation       String?
  cot             String?
  description     String?
  requireApproval Boolean @default(false)

  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  orders  Order[]
}

// 5. Tabel Kode Promo
model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime     @default(now())
  validUntil    DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders  Order[]
}

// 6. Tabel Transaksi
model Transaction {
  id            String   @id @default(cuid())
  amount        Float
  status        String
  paymentMethod String?
  runnerId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  runner  User     @relation(fields: [runnerId], references: [id])
  tickets Ticket[]
}

// 7. Tabel Tiket (E-Ticket / QR Code)
model Ticket {
  id            String   @id @default(cuid())
  qrCode        String   @unique
  isScanned     Boolean  @default(false)
  categoryId    String
  transactionId String
  runnerId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category    TicketCategory @relation(fields: [categoryId], references: [id])
  transaction Transaction    @relation(fields: [transactionId], references: [id])
  runner      User           @relation(fields: [runnerId], references: [id])
}

// 8. Tabel Order (Peserta Checkout)
model Order {
  id               String         @id @default(cuid())
  fullName         String
  email            String
  phone            String
  jerseySize       JerseySize
  bloodType        String?
  emergencyContact String?
  customAnswers    Json?
  totalPrice       Float          // Diubah ke Float agar mendukung diskon/desimal
  isClaimed        Boolean        @default(false)
  approvalStatus   ApprovalStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id], onDelete: Cascade)

  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])

  addonOrders AddonOrder[]
}

// ======================================================
// MODEL MODUL ADDON (MERCH, HOTEL, DLL)
// ======================================================

// 9. Modul Katalog Addon (Dibuat oleh EO)
model Addon {
  id          String    @id @default(cuid())
  eventId     String
  type        AddonType
  name        String
  price       Float
  capacity    Int?
  description String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  addonOrders AddonOrder[]
}

// 10. Modul Pembelian Addon (Dibeli oleh Peserta saat mendaftar)
model AddonOrder {
  id       String @id @default(cuid())
  orderId  String
  addonId  String
  quantity Int    @default(1)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addon Addon @relation(fields: [addonId], references: [id], onDelete: Restrict)
}